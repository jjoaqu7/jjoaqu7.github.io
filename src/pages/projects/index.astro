---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/academic-classic.css';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const groups = [
  { title: 'Devices & experiments', track: 'research' },
  { title: 'Research software', track: 'software' },
];
---

<Base title="Projects" description="All projects by Joaquin Ramirez-Medina in device design, fabrication, experiments, electronics and research software.">
  <article class="academic-classic">
    <div class="academic-content projects-index">
      <header>
        <h1>Projects</h1>
      </header>
      {groups.map(group => {
        const items = projects.filter(project => project.data.track === group.track);
        return items.length > 0 && (
          <section class="academic-section">
            <h2>{group.title}</h2>
            <ul class="academic-projects">
              {items.map(project => (
                <li>
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                  <p>{project.data.summary}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </article>
</Base>

<style>
  .projects-index { padding-top: 18px; }
  .projects-index header { margin-bottom: 14px; }
</style>

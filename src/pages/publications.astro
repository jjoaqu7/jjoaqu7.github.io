---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';

const all = await getCollection('publications');
const sections = [
  { title: 'Papers', items: all.filter((p) => p.data.kind === 'paper') },
  { title: 'Preprints', items: all.filter((p) => p.data.kind === 'preprint') },
  { title: 'Talks and posters', items: all.filter((p) => p.data.kind === 'talk' || p.data.kind === 'poster') },
  { title: 'Media', items: all.filter((p) => p.data.kind === 'media') },
].filter((s) => s.items.length);
---

<Base title="Publications and talks" description="Papers, preprints, talks, posters and media mentions by Joaquin Ramirez-Medina.">
  <header class="proj-head" style="padding-top:48px">
    <span class="eyebrow">Publications</span>
    <h1>Publications and talks</h1>
    <p class="lede">
      Published work only. Manuscripts in preparation or under review are noted on the project page they belong to.
    </p>
  </header>

  {
    sections.map((s) => (
      <section class="section" style="padding-top:48px">
        <div class="section-head">
          <h2>{s.title}</h2>
        </div>
        <PubList items={s.items} />
      </section>
    ))
  }
</Base>

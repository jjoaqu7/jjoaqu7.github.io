---
import { styleConcepts } from '../../data/style-concepts';
import StyleConcept from '../../components/StyleConcept.astro';
import AcademicClassic from '../../components/AcademicClassic.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><meta name="description" content="Light, minimalist design alternatives for Joaquin Ramirez-Medina's portfolio."/><title>Design directions · Portfolio style lab</title></head><body>
<div class="lab-shell"><header class="lab-nav"><a href="/">← Current portfolio</a><span>JRM / DESIGN EXPLORATIONS</span><span>LIGHT MODE · {styleConcepts.length} CONCEPTS</span></header>
<main><section class="lab-intro"><span class="lab-kicker">A different point of view</span><h1>Same researcher.<br/>Different expressions.</h1><p>Light, minimalist directions, each mixing two influences. Explore the typography, spacing, and composition in a full-size preview.</p><div class="lab-note"><span></span>Separate previews. Your current homepage stays as it is.</div></section>
<div class="lab-grid">{styleConcepts.map((style) => <section class="lab-card"><div class="lab-card-top"><span>{style.number} / {String(styleConcepts.length).padStart(2, '0')}</span><span class="lab-swatches"><i style={`background:${style.background}`}></i><i style={`background:${style.color}`}></i></span></div><a class="lab-artboard" href={`/style-lab/${style.slug}/`} aria-label={`Explore ${style.name}`}><div class="lab-mini" aria-hidden="true" inert>{style.slug === 'academic-classic' ? <AcademicClassic/> : <StyleConcept theme={style.slug}/>}</div><span class="lab-open">Explore this direction ↗</span></a><div class="lab-description"><div><h2><a href={`/style-lab/${style.slug}/`}>{style.name} <span>↗</span></a></h2><span class="lab-mix">{style.mix}</span></div><p>{style.description}</p></div></section>)}</div>
</main><footer class="lab-footer"><span>Joaquin Ramirez-Medina / Style studies</span><a href="/">Return to the current portfolio ↗</a></footer></div>
<script>
  const resize = new ResizeObserver((entries) => { for (const entry of entries) { const mini = entry.target.querySelector<HTMLElement>('.lab-mini'); if (mini) mini.style.transform = `scale(${entry.contentRect.width / 1120})`; } });
  document.querySelectorAll('.lab-artboard').forEach((board) => resize.observe(board));
</script>
</body></html>
<style is:global>
body{margin:0;background:#fafaf8;color:#30352f;font:14px/1.6 Arial,Helvetica,sans-serif;color-scheme:light}.lab-shell{max-width:1500px;margin:auto;padding:0 44px}.lab-nav{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #dedfd8;padding:24px 0;font:10px/1.5 Consolas,monospace;letter-spacing:.5px}.lab-nav a,.lab-footer a{color:inherit;text-decoration:none}.lab-nav a:hover,.lab-footer a:hover{text-decoration:underline}.lab-nav>span:last-child{color:#6b7268}.lab-intro{padding:64px 0 52px;max-width:760px}.lab-kicker{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:#67745c}.lab-intro h1{font:400 clamp(38px,4.7vw,62px)/1.07 Georgia,serif;letter-spacing:-2px;margin:20px 0}.lab-intro>p{max-width:530px;color:#666d63;font-size:14px;line-height:1.7}.lab-note{display:flex;align-items:center;gap:8px;font-size:11px;color:#68735f;margin-top:25px}.lab-note>span{width:6px;height:6px;border-radius:50%;background:#7c8c6f}.lab-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px 32px;padding-bottom:70px}.lab-card{min-width:0}.lab-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;font:10px Consolas,monospace;color:#70756c}.lab-swatches{display:flex;gap:4px}.lab-swatches i{display:block;width:15px;height:15px;border:1px solid #0000000c;border-radius:50%}.lab-artboard{display:block;position:relative;overflow:hidden;aspect-ratio:1120/840;border:1px solid #dfe1d8;background:#f6f3e9;color:inherit;isolation:isolate}.lab-mini{width:1120px;height:840px;transform-origin:top left;pointer-events:none;user-select:none}.lab-mini .concept{min-height:840px}.lab-open{position:absolute;right:14px;bottom:14px;border:1px solid #dfe1d8;border-radius:24px;background:#fffffff5;padding:8px 14px;font-size:11px;opacity:0;transform:translateY(4px);transition:opacity .2s,transform .2s}.lab-artboard:hover .lab-open,.lab-artboard:focus-visible .lab-open{opacity:1;transform:none}.lab-artboard:focus-visible,.lab-description a:focus-visible{outline:2px solid #48613d;outline-offset:5px}.lab-description{padding-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:20px}.lab-description h2{font:400 25px Georgia,serif;letter-spacing:-.5px;margin:0 0 6px}.lab-description h2 a{color:inherit;text-decoration:none}.lab-description h2 span{font:16px Arial,sans-serif;margin-left:8px}.lab-mix{font-size:10px;color:#6d7565}.lab-description p{font-size:12px;color:#656d60;margin:0;line-height:1.7}.lab-footer{padding:22px 0 32px;border-top:1px solid #dedfd8;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;font-size:10px;color:#6b7364}@media(max-width:760px){.lab-shell{padding:0 20px}.lab-nav{font-size:9px;gap:12px}.lab-nav>span:last-child{display:none}.lab-intro{padding:44px 0 38px}.lab-grid{grid-template-columns:1fr;gap:36px}.lab-description{gap:16px}.lab-open{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.lab-open{transition:none}}
</style>
